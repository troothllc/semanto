{
  "name": "@trooth/semanto-verify",
  "version": "1.5.1",
  "description": "Check a Semanto signed copy, its response signatures and its transparency log proofs. No dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./verify.d.mts",
      "default": "./verify.mjs"
    },
    "./client": {
      "types": "./client.d.mts",
      "default": "./client.mjs"
    },
    "./answer": {
      "types": "./answer.d.mts",
      "default": "./answer.mjs"
    },
    "./source": {
      "types": "./source.d.mts",
      "default": "./source.mjs"
    },
    "./turn": {
      "types": "./turn.d.mts",
      "default": "./turn.mjs"
    },
    "./frameworks": {
      "types": "./frameworks.d.mts",
      "default": "./frameworks.mjs"
    }
  },
  "bin": {
    "semanto-verify": "./cli.mjs"
  },
  "files": [
    "verify.mjs",
    "verify.d.mts",
    "client.mjs",
    "client.d.mts",
    "answer.mjs",
    "answer.d.mts",
    "source.mjs",
    "source.d.mts",
    "turn.mjs",
    "turn.d.mts",
    "frameworks.mjs",
    "frameworks.d.mts",
    "cli.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troothllc/semanto.git",
    "directory": "verifier/js"
  },
  "bugs": "https://github.com/troothllc/semanto/issues",
  "homepage": "https://trooth.co/docs/semanto"
}
